#!/bin/bash
# worktree_agent - Create a git worktree and launch an AI assistant (claude or codex)

set -e

usage() {
  cat <<'USAGE'
Usage: worktree_agent [branch] [--assistant claude|codex] [--codex|--claude] [-p|--prompt PROMPT]

If branch is omitted, a random name is generated.
Assistant selection:
  - default: codex if installed, else claude
  - override: use --assistant/-a/--tool, --codex/--claude, or set ASSISTANT env var
Prompt:
  - pass -p/--prompt to forward a prompt to the assistant
USAGE
}

BRANCH_NAME=""
ASSISTANT="${ASSISTANT:-}"
PROMPT=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -a|--assistant|--tool)
      if [ -z "${2:-}" ]; then
        echo "Missing assistant value."
        usage
        exit 1
      fi
      ASSISTANT="$2"
      shift 2
      ;;
    --codex)
      ASSISTANT="codex"
      shift
      ;;
    --claude)
      ASSISTANT="claude"
      shift
      ;;
    -p|--prompt)
      if [ -z "${2:-}" ]; then
        echo "Missing prompt value."
        usage
        exit 1
      fi
      PROMPT="$2"
      shift 2
      ;;
    *)
      if [ -z "$BRANCH_NAME" ]; then
        BRANCH_NAME="$1"
        shift
      else
        echo "Unexpected argument: $1"
        usage
        exit 1
      fi
      ;;
  esac
done

if [ -z "$BRANCH_NAME" ]; then
  # Generate random branch name with date prefix: YYYYMMDD-random
  DATE_PREFIX=$(date +%Y%m%d)
  RANDOM_SUFFIX=$(openssl rand -hex 4)
  BRANCH_NAME="${DATE_PREFIX}-${RANDOM_SUFFIX}"
fi

if [ -z "$ASSISTANT" ]; then
  if command -v codex >/dev/null 2>&1; then
    ASSISTANT="codex"
  elif command -v claude >/dev/null 2>&1; then
    ASSISTANT="claude"
  else
    echo "No assistant found. Install codex or claude, or pass --assistant."
    exit 1
  fi
fi

case "$ASSISTANT" in
  codex)
    LAUNCH_CMD=(codex --yolo)
    if [ -n "$PROMPT" ]; then
      LAUNCH_CMD+=("$PROMPT")
    fi
    ;;
  claude)
    LAUNCH_CMD=(claude --dangerously-skip-permissions)
    if [ -n "$PROMPT" ]; then
      LAUNCH_CMD+=("$PROMPT")
    fi
    ;;
  *)
    echo "Unknown assistant: $ASSISTANT"
    usage
    exit 1
    ;;
esac

# Get the main repo root
MAIN_REPO=$(git rev-parse --show-toplevel)
WORKTREE_BASE="${MAIN_REPO}/.agent/worktrees"
mkdir -p "$WORKTREE_BASE"
WORKTREE_PATH="${WORKTREE_BASE}/${BRANCH_NAME}"

# Create worktree
git worktree add "$WORKTREE_PATH" -b "$BRANCH_NAME" 2>/dev/null || \
git worktree add "$WORKTREE_PATH" "$BRANCH_NAME"

# Symlink .agent so the worktree can access the shared inbox system
ln -sfn "${MAIN_REPO}/.agent" "${WORKTREE_PATH}/.agent"

# Change to worktree and launch assistant
cd "$WORKTREE_PATH"
"${LAUNCH_CMD[@]}"
